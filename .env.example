# Local development. Copy to .env and fill in. See docs/ENVIRONMENTS.md.
# On the test/prod hosts these are NOT a file: they are set in cPanel → Setup Node.js App.
# Test currently sets: DATABASE_URL, SESSION_SECRET, CRON_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD,
# UPLOAD_DIR, NEXT_PUBLIC_SITE_URL. Never put real values in this file: it is committed.

# MariaDB connection. URL-encode @ : / in the password.
DATABASE_URL="mysql://root:YOUR_MARIADB_PASSWORD@localhost:3306/boxtop"

# Signs the admin session cookie. 32+ random chars. Changing it logs everyone out.
SESSION_SECRET=""

# Only read by `npm run db:seed` to create the first owner account (skipped if the email exists).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public URL used in emails, links, sitemap. Baked in at build time.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# "1" = keep the site out of search engines (test only). Baked in at build time.
# NEXT_PUBLIC_NOINDEX="1"

# Where uploaded images go. Default ./uploads. On hosts, point outside the app folder.
# UPLOAD_DIR="./uploads"

# Key for /api/cron?key=… (notifications, reminders). Unset = cron endpoint returns 404.
# CRON_SECRET=""
